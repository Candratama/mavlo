{
	"id": "mavlo-app",
	"name": "Mavlo",
	"short_name": "Mavlo",
	"description": "Personal finance tracker. Accounts, transactions, budgets.",
	"start_url": "/dashboard",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "portrait",
	"theme_color": "#f9fafb",
	"background_color": "#f9fafb",
	"prefer_related_applications": false,
	"categories": ["finance", "productivity"],
	"lang": "id",
	"dir": "ltr",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512-maskable.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Add transaction",
			"url": "/transactions",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
		},
		{
			"name": "View budgets",
			"url": "/budgets",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
		}
	]
}
